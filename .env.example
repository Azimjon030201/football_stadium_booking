# Nusxa oling: cp .env.example .env — so'ng haqiqiy qiymatlarni kiriting.
# Bu fayl (.env.example) git'ga yuklanadi, lekin .env YUKLANMAYDI.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stadium_db"

JWT_SECRET="your-secret-here-CHANGE-IN-PRODUCTION"
JWT_REFRESH_SECRET="your-refresh-secret-here-CHANGE-IN-PRODUCTION"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000
APP_TIMEZONE="Asia/Tashkent"

CANCELLATION_DEADLINE_MINUTES=120
MAX_BOOKING_DURATION_MINUTES=180
PAYMENT_EXPIRATION_MINUTES=15

CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development

# Docker Compose uchun (docker-compose.yml shundan o'qiydi)
POSTGRES_DB=stadium_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
