# Copy this file to .env and replace all placeholder values before running the app.
# This file is tracked in Git; your real secret values must stay in .env.

# Required: Prisma database connection for local development.
# For local host usage, keep the port aligned with POSTGRES_PORT below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/stadium_db"

# Required: JWT secrets for access and refresh tokens.
# This project uses JWT_ACCESS_SECRET, not JWT_SECRET.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# Required: app runtime settings.
PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Required for local Docker/Postgres setup used by docker-compose.yml.
POSTGRES_DB="stadium_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5433

# Recommended for production webhook validation. The app checks this value in the payment guard.
# It is optional for local mock-provider development, but should be set in real deployments.
PAYMENT_WEBHOOK_SECRET="replace-with-payment-webhook-secret"

# Optional / not currently consumed by the runtime code, but kept for application defaults.
# If you decide to wire them into the app later, these are the current project defaults.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
APP_TIMEZONE="Asia/Tashkent"
CANCELLATION_DEADLINE_MINUTES=120
MAX_BOOKING_DURATION_MINUTES=180
PAYMENT_EXPIRATION_MINUTES=15
ALLOW_NON_LOCAL_DB="false"