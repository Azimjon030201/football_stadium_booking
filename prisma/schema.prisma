// Football Mini Stadium Booking Platform — Prisma Schema
// SRS asosida tayyorlangan. Har bir squad o'z modeli ustida ishlaydi:
// - Dev1/Dev2: User, RefreshToken
// - Dev3: Stadium, StadiumImage
// - Dev4: Field, WorkingHour, SpecialWorkingDay, FieldImage
// - Tech Lead: Booking, MaintenanceBlock
// - Dev5: Payment
// - Barcha: Review, Favorite, Notification, AuditLog (kichik modullar)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum StadiumStatus {
  DRAFT
  PENDING
  ACTIVE
  BLOCKED
  REJECTED
  ARCHIVED
}

enum FieldType {
  INDOOR
  OUTDOOR
  NATURAL_GRASS
  ARTIFICIAL_GRASS
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  NO_SHOW
  REJECTED
}

enum PaymentProviderType {
  MOCK
  CLICK
  PAYME
  UZUM
  STRIPE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum NotificationType {
  REGISTRATION
  BOOKING_CREATED
  PAYMENT_SUCCESSFUL
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_COMPLETED
  STADIUM_APPROVED
  STADIUM_REJECTED
  ACCOUNT_BLOCKED
}

// ============================================================
// AUTH / USERS  (Dev1, Dev2)
// ============================================================

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  role            UserRole   @default(USER)
  isOwnerVerified Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  stadiums       Stadium[]
  bookings       Booking[]
  refreshTokens  RefreshToken[]
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([status])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// STADIUM  (Dev3)
// ============================================================

model Stadium {
  id              String        @id @default(uuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  name            String
  description     String?
  address         String
  latitude        Float
  longitude       Float
  phone           String
  status          StadiumStatus @default(DRAFT)
  rejectionReason String?
  averageRating   Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  fields    Field[]
  images    StadiumImage[]
  favorites Favorite[]

  @@index([ownerId])
  @@index([status])
  @@index([latitude, longitude])
}

model StadiumImage {
  id        String   @id @default(uuid())
  stadiumId String
  stadium   Stadium  @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([stadiumId])
}

// ============================================================
// FIELD / WORKING HOURS  (Dev4)
// ============================================================

model Field {
  id                String    @id @default(uuid())
  stadiumId         String
  stadium           Stadium   @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  name              String
  fieldType         FieldType
  capacity          Int
  size              String?
  pricePerHour      Decimal   @db.Decimal(10, 2)
  weekendMultiplier Float     @default(1.0)
  peakMultiplier    Float     @default(1.0)
  description       String?
  isActive          Boolean   @default(true)
  averageRating     Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  workingHours      WorkingHour[]
  specialDays       SpecialWorkingDay[]
  bookings          Booking[]
  images            FieldImage[]
  maintenanceBlocks MaintenanceBlock[]
  reviews           Review[]

  @@index([stadiumId])
}

model WorkingHour {
  id         String   @id @default(uuid())
  fieldId    String
  field      Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Yakshanba ... 6=Shanba
  openTime   String? // "HH:mm"
  closeTime  String?
  isClosed   Boolean  @default(false)

  @@unique([fieldId, dayOfWeek])
}

model SpecialWorkingDay {
  id        String   @id @default(uuid())
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  openTime  String?
  closeTime String?
  isClosed  Boolean  @default(false)

  @@unique([fieldId, date])
}

model FieldImage {
  id        String   @id @default(uuid())
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fieldId])
}

// ============================================================
// BOOKING / AVAILABILITY  (Tech Lead)
// ============================================================

model Booking {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  fieldId            String
  field              Field         @relation(fields: [fieldId], references: [id])
  startTime          DateTime
  endTime            DateTime
  duration           Int // daqiqalarda
  price              Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  cancelledBy        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment Payment?
  review  Review?

  @@index([fieldId, startTime])
  @@index([userId])
  @@index([status])
  // MUHIM: tstzrange + GiST EXCLUDE constraint raw SQL migration orqali
  // qo'shiladi (double-booking prevention). Prisma DSL bu turni
  // ifodalay olmaydi — bo'lim: SRS 12.4-band.
}

model MaintenanceBlock {
  id        String   @id @default(uuid())
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@index([fieldId, startTime, endTime])
}

// ============================================================
// PAYMENT  (Dev5)
// ============================================================

model Payment {
  id             String              @id @default(uuid())
  bookingId      String              @unique
  booking        Booking             @relation(fields: [bookingId], references: [id])
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("UZS")
  provider       PaymentProviderType @default(MOCK)
  transactionId  String?             @unique
  status         PaymentStatus       @default(INITIATED)
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
}

// ============================================================
// REVIEW / FAVORITE / NOTIFICATION  (kichik modullar)
// ============================================================

model Review {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  fieldId        String
  field          Field    @relation(fields: [fieldId], references: [id])
  rating         Int
  comment        String?
  ownerResponse  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fieldId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stadiumId String
  stadium   Stadium  @relation(fields: [stadiumId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, stadiumId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ============================================================
// AUDIT LOG  (Admin)
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}
